#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

usage() {
  cat <<'EOF'
avd - download video/audio at the highest available quality

Usage:
  avd -v <url>   Download video (YouTube, TikTok, Instagram Reels, and
                 anything else yt-dlp supports)
  avd -a <url>   Download audio only, as mp3
  avd -h, --help       Show this help
  avd --version        Show version

Files are saved to ~/Downloads.
EOF
}

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "error: yt-dlp is not installed. Run install.sh from https://github.com/Sanjay18bala/avd, or 'brew install yt-dlp'." >&2
  exit 1
fi

case "${1:-}" in
  --help) usage; exit 0 ;;
  --version) echo "avd $VERSION"; exit 0 ;;
esac

mode=""
url=""

while getopts ":v:a:h" opt; do
  case "$opt" in
    v) mode="video"; url="$OPTARG" ;;
    a) mode="audio"; url="$OPTARG" ;;
    h) usage; exit 0 ;;
    :) echo "error: -$OPTARG requires a URL argument" >&2; usage; exit 1 ;;
    \?) echo "error: unknown option -$OPTARG" >&2; usage; exit 1 ;;
  esac
done

if [[ -z "$mode" ]]; then
  usage
  exit 1
fi

mkdir -p "$HOME/Downloads"
output_template="$HOME/Downloads/%(title)s.%(ext)s"

progress_opts=(-q --no-warnings --progress --newline
  --progress-template "download:P|%(progress._percent_str)s|%(progress._speed_str)s|%(progress._eta_str)s")

spinner_frames=$'⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏'
spinner_awk='
  BEGIN { split(spin, f, " "); i = 0 }
  /^P\|/ {
    split($0, p, "|")
    printf "\r\033[1;34m%s\033[0m  %-8s %-12s eta %-8s", f[i % 10 + 1], p[2], p[3], p[4]
    fflush()
    i++
  }
  END { if (i > 0) printf "\n" }
'

run_yt_dlp() {
  if [[ -t 1 ]]; then
    yt-dlp "${progress_opts[@]}" "$@" | awk -v spin="$spinner_frames" "$spinner_awk"
  else
    yt-dlp "${progress_opts[@]}" "$@"
  fi
}

if [[ "$mode" == "video" ]]; then
  run_yt_dlp -f "bestvideo+bestaudio/best" --recode-video mp4 -o "$output_template" "$url"
else
  run_yt_dlp -f "bestaudio/best" -x --audio-format mp3 --audio-quality 0 -o "$output_template" "$url"
fi
