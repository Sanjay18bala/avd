#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

usage() {
  cat <<'EOF'
avd - download video/audio at the highest available quality

Usage:
  avd -v <url>   Download video (YouTube, TikTok, Instagram Reels, and
                 anything else yt-dlp supports)
  avd -a <url>   Download audio only, as mp3
                 (in an interactive terminal, prompts for quality)
  avd -h, --help       Show this help
  avd --version        Show version

Files are saved to ~/Downloads.
EOF
}

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "error: yt-dlp is not installed. Run install.sh from https://github.com/Sanjay18bala/avd, or 'brew install yt-dlp'." >&2
  exit 1
fi

case "${1:-}" in
  --help) usage; exit 0 ;;
  --version) echo "avd $VERSION"; exit 0 ;;
esac

mode=""
url=""

while getopts ":v:a:h" opt; do
  case "$opt" in
    v) mode="video"; url="$OPTARG" ;;
    a) mode="audio"; url="$OPTARG" ;;
    h) usage; exit 0 ;;
    :) echo "error: -$OPTARG requires a URL argument" >&2; usage; exit 1 ;;
    \?) echo "error: unknown option -$OPTARG" >&2; usage; exit 1 ;;
  esac
done

if [[ -z "$mode" ]]; then
  usage
  exit 1
fi

select_quality() {
  local mode="$1" url="$2"
  echo "Fetching available qualities..." >&2

  local json
  json=$(yt-dlp -j --skip-download -q --no-warnings "$url" 2>/dev/null) || return 1

  local py_prog
  py_prog=$(cat <<'PYEOF'
import json, sys

mode = sys.argv[1]
data = json.load(sys.stdin)
formats = data.get('formats') or []

if mode == 'video':
    vals = sorted({f.get('height') for f in formats
                   if f.get('vcodec') not in (None, 'none') and f.get('height')},
                  reverse=True)
    for h in vals[:4]:
        label = f"{h}p" + (" (4K)" if h >= 2160 else "")
        print(f"{h}|{label}")
else:
    vals = sorted({round(f.get('abr')) for f in formats
                   if f.get('vcodec') in (None, 'none')
                   and f.get('acodec') not in (None, 'none')
                   and f.get('abr')},
                  reverse=True)
    for a in vals[:4]:
        print(f"{a}|{a}kbps")
PYEOF
  )

  local parsed
  parsed=$(printf '%s' "$json" | python3 -c "$py_prog" "$mode")
  [[ -z "$parsed" ]] && return 1

  local values=() labels=()
  while IFS='|' read -r value label; do
    values+=("$value")
    labels+=("$label")
  done <<< "$parsed"
  labels[0]="${labels[0]} [default]"

  echo "Available qualities:" >&2
  local i=1
  for label in "${labels[@]}"; do
    echo "  $i) $label" >&2
    i=$((i + 1))
  done

  local choice
  while true; do
    if ! read -r -p "Select [1-${#values[@]}, Enter for default]: " choice; then
      choice=1
      break
    fi
    if [[ -z "$choice" ]]; then
      choice=1
      break
    elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#values[@]} )); then
      break
    else
      echo "Invalid choice." >&2
    fi
  done

  echo "${values[$((choice - 1))]}"
}

chosen=""
if [[ -t 0 && -t 1 ]]; then
  chosen=$(select_quality "$mode" "$url") || chosen=""
fi

mkdir -p "$HOME/Downloads"
output_template="$HOME/Downloads/%(title)s.%(ext)s"

progress_opts=(-q --no-warnings --progress --newline
  --progress-template "download:P|%(progress._percent_str)s|%(progress._speed_str)s|%(progress._eta_str)s")

spinner_frames=$'⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏'
spinner_awk='
  BEGIN { split(spin, f, " "); i = 0 }
  /^P\|/ {
    split($0, p, "|")
    printf "\r\033[1;34m%s\033[0m  %-8s %-12s eta %-8s", f[i % 10 + 1], p[2], p[3], p[4]
    fflush()
    i++
  }
  END { if (i > 0) printf "\n" }
'

run_yt_dlp() {
  if [[ -t 1 ]]; then
    yt-dlp "${progress_opts[@]}" "$@" | awk -v spin="$spinner_frames" "$spinner_awk"
  else
    yt-dlp "${progress_opts[@]}" "$@"
  fi
}

if [[ "$mode" == "video" ]]; then
  if [[ -n "$chosen" ]]; then
    video_format="bestvideo[height<=$chosen]+bestaudio/best[height<=$chosen]"
  else
    video_format="bestvideo+bestaudio/best"
  fi
  run_yt_dlp -f "$video_format" --recode-video mp4 -o "$output_template" "$url"
else
  if [[ -n "$chosen" ]]; then
    audio_format="bestaudio[abr<=$chosen]/bestaudio"
  else
    audio_format="bestaudio/best"
  fi
  run_yt_dlp -f "$audio_format" -x --audio-format mp3 --audio-quality 0 -o "$output_template" "$url"
fi
